-- ====================== HELPERS ======================
local function getPlayerNames()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.Name)
        end
    end
    table.sort(list)
    return list
end

local function getTeamNames()
    local list = {}
    for _, team in ipairs(Teams:GetTeams()) do
        table.insert(list, team.Name)
    end
    table.sort(list)
    return list
end

local function isInList(name, list)
    for _, v in ipairs(list) do
        if v == name then return true end
    end
    return false
end

local function IsVisible(part)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not part then return false end

    local origin = root.Position
    local targetPos = part.Position
    local direction = targetPos - origin
    local distance = direction.Magnitude
    if distance == 0 then return true end

    local ignoreList = {LocalPlayer.Character}
    local ray = Ray.new(origin, direction.Unit * distance)

    for _ = 1, 15 do
        local hit = workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)
        if not hit then
            return true
        end

        if hit:IsDescendantOf(part.Parent) then
            return true
        end

        if ignoreTransparent and hit.Transparency >= 1 then
            table.insert(ignoreList, hit)
            local hitDist = (hit.Position - origin).Magnitude
            if hitDist >= distance then
                return true
            end
            origin = origin + direction.Unit * (hitDist + 0.1)
            ray = Ray.new(origin, direction.Unit * (distance - hitDist))
        else
            return false
        end
    end

    return false
end

local function GetBestVisiblePart(character)
    if not character then return nil end

    local preferred = character:FindFirstChild(aimpart)
    if preferred and preferred:IsA("BasePart") and IsVisible(preferred) then
        return preferred
    end

    if not visiblePartLock then
        return preferred and preferred:IsA("BasePart") and IsVisible(preferred) and preferred or nil
    end

    for _, partName in ipairs(partPriority) do
        if partName == aimpart then continue end
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") and IsVisible(part) then
            return part
        end
    end

    return nil
end

local function passesBasicFilters(plr, hum)
    if hum.Health <= minHealth then return false end
    if teamcheck and plr.Team == LocalPlayer.Team then return false end
    if friendcheck and LocalPlayer:IsFriendsWith(plr.UserId) then return false end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    local checkPart = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
    if not checkPart then return false end
    if (checkPart.Position - myRoot.Position).Magnitude > maxDistance then return false end

    -- Do not lock onto people below you
    if checkPart.Position.Y < myRoot.Position.Y - 2 then
        return false
    end

    if isInList(plr.Name, whitelistPlayers) then return false end
    if plr.Team and isInList(plr.Team.Name, whitelistTeams) then return false end

    return true
end

local function findBestTarget(preferPlayers, preferTeams)
    local closest = nil
    local closestValue = math.huge
    local screenCenter = Camera.ViewportSize / 2
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or not passesBasicFilters(plr, hum) then continue end

        local part = GetBestVisiblePart(char)
        if not part then continue end

        if wallcheck and not visiblePartLock and not IsVisible(part) then continue end

        local isPreferredPlayer = isInList(plr.Name, preferredPlayers)
        local isPreferredTeam = plr.Team and isInList(plr.Team.Name, preferredTeams)

        if preferPlayers and not isPreferredPlayer then continue end
        if preferTeams and not isPreferredTeam then continue end
        if not preferPlayers and not preferTeams then
            if isPreferredPlayer or isPreferredTeam then continue end
        end

        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if onScreen then
            local screenDist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
            if screenDist < closestValue then
                closestValue = screenDist
                closest = part
            end
        end
    end

    if not closest and fov360 then
        closestValue = math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local char = plr.Character
            if not char then continue end

            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or not passesBasicFilters(plr, hum) then continue end

            local part = GetBestVisiblePart(char)
            if not part then continue end

            if wallcheck and not visiblePartLock and not IsVisible(part) then continue end

            local isPreferredPlayer = isInList(plr.Name, preferredPlayers)
            local isPreferredTeam = plr.Team and isInList(plr.Team.Name, preferredTeams)

            if preferPlayers and not isPreferredPlayer then continue end
            if preferTeams and not isPreferredTeam then continue end
            if not preferPlayers and not preferTeams then
                if isPreferredPlayer or isPreferredTeam then continue end
            end

            local distance = (part.Position - myRoot.Position).Magnitude
            if distance < closestValue then
                closestValue = distance
                closest = part
            end
        end
    end

    return closest
end

local function GetClosestTarget()
    local t = findBestTarget(true, false)
    if t then return t end
    t = findBestTarget(false, true)
    if t then return t end
    return findBestTarget(false, false)
end

-- ====================== TRIGGERBOT LOGIC ======================
local function canTriggerbotShoot(targetPart)
    if not targetPart or not targetPart.Parent then return false end

    local char = targetPart.Parent
    local hum = char:FindFirstChildOfClass("Humanoid")
    local plr = Players:GetPlayerFromCharacter(char)
    if not hum or not plr then return false end

    if hum.Health <= triggerMinHealth then return false end
    if isInList(plr.Name, triggerWhitelist) then return false end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    if (targetPart.Position - myRoot.Position).Magnitude > triggerMaxDistance then return false end

    if teamcheck and plr.Team == LocalPlayer.Team then return false end

    return true
end

local function doClick()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.02)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

-- ====================== ESP / CHAMS LOGIC ======================
local function getHealthColor(humanoid)
    local percent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
    if percent > 0.5 then
        return Color3.fromRGB(255, 255, 0):Lerp(Color3.fromRGB(0, 255, 0), (percent - 0.5) * 2)
    else
        return Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(255, 255, 0), percent * 2)
    end
end

local function removeCham(player)
    if Highlights[player] then
        Highlights[player]:Destroy()
        Highlights[player] = nil
    end
end

local function updateCham(player)
    if player == LocalPlayer then return end

    local character = player.Character
    if not character then
        removeCham(player)
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        removeCham(player)
        return
    end

    if ESPSettings.DeadCheck and humanoid.Health <= 0 then
        removeCham(player)
        return
    end

    if ESPSettings.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        removeCham(player)
        return
    end

    local highlight = Highlights[player]
    if not highlight or not highlight.Parent then
        highlight = Instance.new("Highlight")
        highlight.Name = "BetterCham"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.OutlineTransparency = 1
        highlight.FillTransparency = 0.65
        highlight.Parent = character
        Highlights[player] = highlight
    end

    if ESPSettings.HealthBased then
        highlight.FillColor = getHealthColor(humanoid)
    else
        highlight.FillColor = ESPSettings.FillColor
    end

    highlight.Enabled = ESPSettings.Enabled
end

