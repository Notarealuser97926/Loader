-- ====================== MAIN LOOP ======================
RunService.Heartbeat:Connect(function()
    -- CFrame Speed + Anti Noclip
    if cframeSpeedEnabled then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hrp and hum then
            local dir = hum.MoveDirection
            if dir.Magnitude > 0 then
                local moveAmount = dir * (cframeSpeedValue / 50)

                if antiNoclip then
                    local ray = Ray.new(hrp.Position, moveAmount)
                    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {char})
                    if hit then
                        local hitDist = (hit.Position - hrp.Position).Magnitude
                        if hitDist > 2 then
                            moveAmount = dir.Unit * math.min(moveAmount.Magnitude, hitDist - 1.5)
                            hrp.CFrame = hrp.CFrame + moveAmount
                        end
                        -- else don't move into the wall
                    else
                        hrp.CFrame = hrp.CFrame + moveAmount
                    end
                else
                    hrp.CFrame = hrp.CFrame + moveAmount
                end
            end
        end
    end

    -- Offset label
    offsetLabel:Set(verticalOffset .. " px")

    -- ESP / Chams
    if not ESPSettings.Enabled then
        for player, _ in pairs(Highlights) do
            removeCham(player)
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            updateCham(player)
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if not aimlock or not HoldingTrigger then
        Target = nil
        return
    end

    if Target and liveWallCheck and not IsVisible(Target) then
        Target = nil
    end

    if Target and Target.Parent then
        local best = GetBestVisiblePart(Target.Parent)
        if best then
            Target = best
        else
            Target = nil
        end
    end

    if not Target or not Target.Parent or not Target.Parent:FindFirstChildOfClass("Humanoid") or Target.Parent.Humanoid.Health <= minHealth then
        Target = GetClosestTarget()
    end

    if Target then
        local targetPos = Target.Position

        if verticalOffset ~= 0 then
            local screenPos = Camera:WorldToViewportPoint(targetPos)
            local offsetPos = Vector3.new(screenPos.X, screenPos.Y - verticalOffset, screenPos.Z)
            local ray = Camera:ViewportPointToRay(offsetPos.X, offsetPos.Y)
            targetPos = Camera.CFrame.Position + ray.Direction * (targetPos - Camera.CFrame.Position).Magnitude
        end

        local goal = CFrame.new(Camera.CFrame.Position, targetPos)

        if smoothness <= 0 then
            Camera.CFrame = goal
        else
            Camera.CFrame = Camera.CFrame:Lerp(goal, smoothness)
        end
    end

    -- Triggerbot
    if triggerbotEnabled and Target and canTriggerbotShoot(Target) then
        local now = tick()

        if triggerOneTap then
            if lastOneTapTarget ~= Target then
                doClick()
                lastOneTapTarget = Target
                lastShotTime = now
            end
        else
            if now - lastShotTime >= triggerShotDelay then
                doClick()
                lastShotTime = now
            end
        end
    end
end)

