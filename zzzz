-- ====================== HELPERS ======================
local function getPlayerNames()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.Name)
        end
    end
    table.sort(list)
    return list
end

local function getTeamNames()
    local list = {}
    for _, team in ipairs(Teams:GetTeams()) do
        table.insert(list, team.Name)
    end
    table.sort(list)
    return list
end

local function isInList(name, list)
    for _, v in ipairs(list) do
        if v == name then return true end
    end
    return false
end

local function IsVisible(part)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not part then return false end

    local direction = part.Position - root.Position
    local ray = Ray.new(root.Position, direction.Unit * direction.Magnitude)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character})
    return hit == nil or hit:IsDescendantOf(part.Parent)
end

local function GetBestVisiblePart(character)
    if not character then return nil end

    local preferred = character:FindFirstChild(aimpart)
    if preferred and preferred:IsA("BasePart") and IsVisible(preferred) then
        return preferred
    end

    if not visiblePartLock then
        return preferred and preferred:IsA("BasePart") and IsVisible(preferred) and preferred or nil
    end

    for _, partName in ipairs(partPriority) do
        if partName == aimpart then continue end
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") and IsVisible(part) then
            return part
        end
    end

    return nil
end

local function passesBasicFilters(plr, hum)
    if hum.Health <= minHealth then return false end
    if teamcheck and plr.Team == LocalPlayer.Team then return false end
    if friendcheck and LocalPlayer:IsFriendsWith(plr.UserId) then return false end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    local checkPart = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
    if not checkPart then return false end
    if (checkPart.Position - myRoot.Position).Magnitude > maxDistance then return false end

    if isInList(plr.Name, whitelistPlayers) then return false end
    if plr.Team and isInList(plr.Team.Name, whitelistTeams) then return false end

    return true
end

local function findBestTarget(preferPlayers, preferTeams)
    local closest = nil
    local closestValue = math.huge
    local screenCenter = Camera.ViewportSize / 2
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or not passesBasicFilters(plr, hum) then continue end

        local part = GetBestVisiblePart(char)
        if not part then continue end

        if wallcheck and not visiblePartLock and not IsVisible(part) then continue end

        local isPreferredPlayer = isInList(plr.Name, preferredPlayers)
        local isPreferredTeam = plr.Team and isInList(plr.Team.Name, preferredTeams)

        if preferPlayers and not isPreferredPlayer then continue end
        if preferTeams and not isPreferredTeam then continue end
        if not preferPlayers and not preferTeams then
            if isPreferredPlayer or isPreferredTeam then continue end
        end

        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if onScreen then
            local screenDist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
            if screenDist < closestValue then
                closestValue = screenDist
                closest = part
            end
        end
    end

    if not closest and fov360 then
        closestValue = math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local char = plr.Character
            if not char then continue end

            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or not passesBasicFilters(plr, hum) then continue end

            local part = GetBestVisiblePart(char)
            if not part then continue end

            if wallcheck and not visiblePartLock and not IsVisible(part) then continue end

            local isPreferredPlayer = isInList(plr.Name, preferredPlayers)
            local isPreferredTeam = plr.Team and isInList(plr.Team.Name, preferredTeams)

            if preferPlayers and not isPreferredPlayer then continue end
            if preferTeams and not isPreferredTeam then continue end
            if not preferPlayers and not preferTeams then
                if isPreferredPlayer or isPreferredTeam then continue end
            end

            local distance = (part.Position - myRoot.Position).Magnitude
            if distance < closestValue then
                closestValue = distance
                closest = part
            end
        end
    end

    return closest
end

local function GetClosestTarget()
    local t = findBestTarget(true, false)
    if t then return t end
    t = findBestTarget(false, true)
    if t then return t end
    return findBestTarget(false, false)
end

-- ====================== TRIGGERBOT LOGIC ======================
local function canTriggerbotShoot(targetPart)
    if not targetPart or not targetPart.Parent then return false end

    local char = targetPart.Parent
    local hum = char:FindFirstChildOfClass("Humanoid")
    local plr = Players:GetPlayerFromCharacter(char)
    if not hum or not plr then return false end

    if hum.Health <= triggerMinHealth then return false end
    if isInList(plr.Name, triggerWhitelist) then return false end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    if (targetPart.Position - myRoot.Position).Magnitude > triggerMaxDistance then return false end

    if teamcheck and plr.Team == LocalPlayer.Team then return false end

    return true
end

local function doClick()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.03)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

-- ====================== INPUT (PC - Right Click) ======================
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        HoldingTrigger = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        HoldingTrigger = false
        Target = nil
        lastOneTapTarget = nil
    end
end)

-- ====================== MAIN LOOP ======================
RunService.RenderStepped:Connect(function()
    if not aimlock or not HoldingTrigger then
        Target = nil
        return
    end

    if Target and liveWallCheck and not IsVisible(Target) then
        Target = nil
    end

    if Target and Target.Parent then
        local best = GetBestVisiblePart(Target.Parent)
        if best then
            Target = best
        else
            Target = nil
        end
    end

    if not Target or not Target.Parent or not Target.Parent:FindFirstChildOfClass("Humanoid") or Target.Parent.Humanoid.Health <= minHealth then
        Target = GetClosestTarget()
    end

    if Target then
        local targetPos = Target.Position

        if verticalOffset ~= 0 then
            local screenPos = Camera:WorldToViewportPoint(targetPos)
            local offsetPos = Vector3.new(screenPos.X, screenPos.Y - verticalOffset, screenPos.Z)
            local ray = Camera:ViewportPointToRay(offsetPos.X, offsetPos.Y)
            targetPos = Camera.CFrame.Position + ray.Direction * (targetPos - Camera.CFrame.Position).Magnitude
        end

        local goal = CFrame.new(Camera.CFrame.Position, targetPos)

        if smoothness <= 0 then
            Camera.CFrame = goal
        else
            Camera.CFrame = Camera.CFrame:Lerp(goal, smoothness)
        end
    end

    if triggerbotEnabled and Target and canTriggerbotShoot(Target) then
        local now = tick()

        if triggerOneTap then
            if lastOneTapTarget ~= Target then
                doClick()
                lastOneTapTarget = Target
                lastShotTime = now
            end
        else
            if now - lastShotTime >= triggerShotDelay then
                doClick()
                lastShotTime = now
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    offsetLabel:Set(verticalOffset .. " px")
end)

